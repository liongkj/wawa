{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "wawa-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "WAITLIST", "database_name": "wawa-waitlist", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "waitlist-worker/migrations" }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@wawa.liongkj.com"] }]
}

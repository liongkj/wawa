# Defaults bind the application to localhost. Never commit your actual .env.
PORT=2786
# For a domain or reverse proxy, set its exact origin (no path).
# PUBLIC_ORIGIN=https://tasks.example.com
# Optional exact additional HTTPS addresses, separated by commas. Remote additions require APP_PASSWORD.
# ADDITIONAL_ORIGINS=https://machine.tailnet.ts.net:8443
# Username is admin. Use a strong, unique password for network access.
# APP_PASSWORD=
# Only use this when your reverse proxy already authenticates every user.
# TRUST_PROXY_AUTH=true
# Optional: proxy addresses or CIDR ranges whose X-Forwarded-For is believed, so pairing
# lockouts count each client instead of the proxy. Leave unset when nothing proxies the app.
# TRUSTED_PROXIES=172.16.0.0/12
# Optional: enable MCP model access with a separate random token (at least 32 characters).
# MCP_TOKEN=
